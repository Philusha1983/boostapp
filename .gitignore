# macOS
.DS_Store

# Release artifacts (built by scripts/build.sh, attached to GitHub Releases)
*.zip
dist/

# Python
__pycache__/
*.pyc

# Editors
.vscode/
.idea/

# --- Docs policy -----------------------------------------------------------
# Exploration/research/planning MD docs are PRIVATE by default and must never
# be published. Only user-facing docs belong in the repo: how to install/use
# the extension, Q&A, changelog. To publish a new root-level doc, whitelist
# it explicitly below (like README/CHANGELOG). See CLAUDE.md.
/*.md
!/README.md
!/CHANGELOG.md
notes/
Claude outputs/
zieArqzr
CLAUDE.md

# Store-listing renders (regenerate: node scripts/screenshots/render.js all store)
docs/assets/*-store.png
