{
  "manifest_version": 3,
  "name": "Boost Auto-Book (Training Harmony)",
  "version": "1.0.0",
  "description": "Watchlist + automatic registration for BoostApp group lessons. Books the instant the 72h registration window opens.",
  "permissions": ["storage", "alarms", "notifications", "cookies", "scripting", "tabs"],
  "host_permissions": [
    "https://app.boostapp.co.il/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Boost Auto-Book",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.boostapp.co.il/Home.php*", "https://app.boostapp.co.il/indexnew.php*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "icons/*.png", "app.webmanifest"],
      "matches": ["<all_urls>"]
    }
  ]
}
